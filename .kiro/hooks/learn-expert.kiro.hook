{
  "enabled": false,
  "name": "LEARN — Expert Output (DISABLED)",
  "version": "1.1.0",
  "description": "DISABLED: Initial Expert drafts (logic_explanation, test_plan) rarely contain new findings worth learning from. Learning happens at the Reviewer/Closure stage via learn-on-findings.kiro.hook instead.",
  "when": {
    "type": "fileCreated",
    "patterns": ["**/1_Expert/logic_explanation*.md", "**/1_Expert/test_plan*.md"]
  },
  "then": {
    "type": "askAgent",
    "prompt": "This hook is disabled. Learning from Expert outputs was causing noise. Lessons are captured at the Reviewer stage instead."
  }
}