{
  "enabled": false,
  "name": "Shared Brain — Learn Phase (DISABLED — merged into learn-on-findings)",
  "description": "DISABLED: Functionality merged into learn-on-findings.kiro.hook to avoid duplicate triggers on 4_Reviewer files.",
  "version": "2",
  "when": {
    "type": "fileCreated",
    "patterns": [
      "**/4_Reviewer/EXECUTION_FINDINGS*.md",
      "**/4_Reviewer/FINAL_CLOSURE_REPORT*.md"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "This hook is disabled. Use learn-on-findings.kiro.hook instead."
  }
}