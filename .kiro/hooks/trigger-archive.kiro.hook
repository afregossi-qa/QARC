{
  "enabled": true,
  "name": "Archive Ticket Context",
  "description": "When FINAL_CLOSURE_REPORT is validated and saved, archive intermediate state files into 7_Archive/ subfolder",
  "version": "2",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "**/4_Reviewer/FINAL_CLOSURE_REPORT_*_VALIDATED.md"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Create a subfolder named 7_Archive/ within the current ticket directory if it doesn't exist. Move the following intermediate state files into the 7_Archive/ folder: 1_Expert/manual_input_OK.md, 1_Expert/test_plan_OK.md, 1_Expert/test_plan_PENDING.md (if exists), 2_Validator/FINAL_TEST_CASES_[ID]_PENDING.md (if exists). Ensure the 4_Reviewer/FINAL_CLOSURE_REPORT_VALIDATED.md and AIO_SYNC_LOG.md remain in their current locations for easy access. Stop after archiving."
  }
}