{
  "enabled": true,
  "name": "MCP Tool Count Watcher",
  "description": "When a prompt is submitted, checks if the system has warned about too many MCP tools (50+). If so, analyzes tool usage across agents and proposes disabling unused tools to stay under the threshold.",
  "version": "1",
  "when": {
    "type": "promptSubmit"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Check if the current message or system context contains a warning about too many MCP tools being enabled (50+ tools threshold). If it does, act as the MCP Watcher Agent: 1) Read .kiro/settings/mcp.json to count enabled tools per server, 2) Read all .kiro/agents/*.json to identify which tools are actively used, 3) Identify tools that are enabled but not used by any agent and not in any autoApprove list, 4) Propose disabling the unused tools to bring the count below 50, 5) Present the proposal to the user before making changes. If there is NO warning about tool count, do nothing and proceed normally.\n\nWarning message from KiroAgent:\n          We recommend disabling servers or tools to keep this below 50, as too many tools lead to\n          degraded agent tool selection and high token usage consuming significant context.\n          You can disable servers and tools from the MCP Servers view.\n        "
  },
  "workspaceFolderName": "TestCasesIdentification&Design",
  "shortName": "mcp-tool-watcher"
}